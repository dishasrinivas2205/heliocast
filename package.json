{
  "name": "helliocast",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "start": "concurrently -k -n \"BACKEND,FRONTEND\" -c \"magenta.bold,cyan.bold\" \"npm run server\" \"npm run client\"",
    "dev": "concurrently -k -n \"BACKEND,FRONTEND\" -c \"magenta.bold,cyan.bold\" \"npm run server\" \"npm run client\"",
    "server": "python3 server.py",
    "client": "vite --host 127.0.0.1 --port 5173",
    "build": "vite build",
    "preview": "vite preview"
  },
  "devDependencies": {
    "concurrently": "^10.0.6",
    "vite": "^8.3.4"
  },
  "dependencies": {
    "canvas-confetti": "^1.9.4",
    "jszip": "^3.10.2"
  }
}
