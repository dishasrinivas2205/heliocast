{
  "mission": "ISRO Aditya-L1",
  "instruments": {
    "solexs": {
      "name": "Solar Low Energy X-ray Spectrometer",
      "detector_type": "Silicon Drift Detector (SDD)",
      "passband_kev": [1.0, 22.0],
      "primary_measurement": "Thermal plasma heating & emission measure",
      "flare_classes": ["A", "B", "C", "M", "X"]
    },
    "helios": {
      "name": "High Energy L1 Orbiting X-ray Spectrometer",
      "detector_type": "Cadmium Zinc Telluride (CZT) & CdTe",
      "passband_kev": [10.0, 150.0],
      "primary_measurement": "Non-thermal electron bremsstrahlung",
      "burst_trigger_multiplier": 3.5
    }
  },
  "physics": {
    "neupert_effect_verification": true,
    "max_coincidence_delay_sec": 180.0,
    "min_pearson_correlation": 0.60
  },
  "forecasting": {
    "horizons_minutes": [15, 30, 45],
    "lead_window_default_min": 30.0,
    "alert_threshold": 0.60,
    "causal_feature_window_steps": 60
  },
  "storage": {
    "database": "data/catalog/aditya_flares.db",
    "master_catalog_csv": "data/catalog/aditya_l1_master_flare_catalog.csv"
  }
}
